{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-spec-reads.sh"],
            "timeout": 10,
            "statusMessage": "Checking the read is bounded"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-frozen-writes.sh"],
            "timeout": 10,
            "statusMessage": "Checking the file is not frozen"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh"],
            "timeout": 10,
            "statusMessage": "Checking the command against the project rules"
          },
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/precommit.sh"],
            "timeout": 60,
            "statusMessage": "Running the pre-commit checks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/postcommit.sh"],
            "timeout": 10,
            "statusMessage": "Checking the commit message"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"],
            "timeout": 10,
            "statusMessage": "Loading STATE.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-state-stamp.sh"],
            "timeout": 10,
            "statusMessage": "Checking STATE.md is stamped"
          }
        ]
      }
    ]
  }
}
