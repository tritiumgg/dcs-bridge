{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-spec-reads.sh"],
            "timeout": 10,
            "statusMessage": "Checking the read is bounded"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-frozen-writes.sh"],
            "timeout": 10,
            "statusMessage": "Checking the file is not frozen"
          }
        ]
      }
    ]
  }
}
