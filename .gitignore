# Cargo build output. tools/mkimplib.sh writes the generated import library
# here too, and tools/mkschema.sh the compiled schema, so this is needed from
# the first run rather than from the first cargo build.
/target/

# Local agent settings. .claude/settings.json is shared; this is not.
.claude/settings.local.json

# Staged release artifacts. tools/stage-release.sh writes them here, and the
# workflows upload them from the same place.
/dist/
